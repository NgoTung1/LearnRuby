<% 
def get_fa_icon(code)
  case code
  when /01/ then { class: "fas fa-sun", color: "#f59e0b" }
  when /02/, /03/, /04/ then { class: "fas fa-cloud-sun", color: "#64748b" }
  when /09/, /10/ then { class: "fas fa-cloud-showers-heavy", color: "#3b82f6" }
  when /11/ then { class: "fas fa-bolt", color: "#eab308" }
  when /13/ then { class: "fas fa-snowflake", color: "#38bdf8" }
  else { class: "fas fa-cloud", color: "#94a3b8" }
  end
end 

# Hàm lấy tên thứ trong tuần (Tiếng Việt)
def get_weekday(date_string)
  days = ["Chủ nhật", "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7"]
  days[Date.parse(date_string).wday]
end
%>

<style>
  /* ÉP BỎ CSS CACHE CŨ BẰNG !IMPORTANT */
  .home-container { max-width: 1500px !important; }
  .result-section { max-width: 100% !important; width: 100% !important; }
  
  .weather-dashboard {
    display: grid;
    gap: 30px;
    grid-template-columns: 1fr; /* Mặc định 1 cột (Xếp dọc cho Laptop) */
  }
  
  .weather-dashboard-left {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  /* CHỈ KHI MÀN HÌNH CỰC TO (PC > 1300px) MỚI CHIA 2 CỘT */
  @media (min-width: 1300px) {
    .weather-dashboard {
      grid-template-columns: 1fr 450px; /* Cột trái linh hoạt, cột phải 450px để đủ chỗ hiện min/max */
      align-items: start;
    }
  }
</style>

<div class="weather-dashboard">
  
  <!-- CỘT TRÁI (Bao gồm Hiện tại + 24 giờ tới) -->
  <div class="weather-dashboard-left">
    
    <!-- PHẦN 1: THỜI TIẾT HIỆN TẠI -->
    <div style="background: white; border-radius: 24px; padding: 35px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.03); position: relative; display: flex; flex-wrap: wrap; gap: 30px; align-items: center; justify-content: space-between;">
      
      <% if logged_in? && current_user.is_verified? %>
        <% existing_fav = current_user.favorites.find_by(city_name: @climate['name']) %>
        <button type="button" id="js-fav-btn" class="btn-fav-toggle <%= 'is-favorite' if existing_fav %>" data-city="<%= @climate['name'] %>" data-fav-id="<%= existing_fav&.id %>" style="position: absolute; top: 20px; right: 20px; border: none; background: #f8fafc; border-radius: 50%; width: 45px; height: 45px; cursor: pointer; transition: 0.3s; display: flex; align-items: center; justify-content: center;">
          <i class="<%= existing_fav ? 'fas fa-heart' : 'far fa-heart' %>" style="color: <%= existing_fav ? '#ef4444' : '#94a3b8' %>; font-size: 20px;"></i>
        </button>
      <% end %>

      <!-- Nhiệt độ & Icon -->
      <div style="display: flex; gap: 25px; align-items: center; flex: 1; min-width: 300px;">
        <% icon_data = get_fa_icon(@climate['weather'][0]['icon']) %>
        <div style="width: 110px; height: 110px; display: flex; align-items: center; justify-content: center;">
          <i class="<%= icon_data[:class] %>" style="font-size: 85px; color: <%= icon_data[:color] %>;"></i>
        </div>
        <div>
          <h2 style="margin: 0; font-size: 32px; color: #0f172a; font-weight: 800;"><%= @climate['name'] %>, <%= @climate['sys']['country'] %></h2>
          <p style="margin: 6px 0 0 0; color: #64748b; font-size: 18px; text-transform: capitalize;"><%= @climate['weather'][0]['description'] %></p>
          <h1 style="margin: 5px 0 0 0; font-size: 64px; color: #0f172a; font-weight: 900; letter-spacing: -2px; line-height: 1;"><%= @climate['main']['temp'].round %>°</h1>
        </div>
      </div>

      <!-- Thông số chi tiết -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; background: #f8fafc; padding: 25px; border-radius: 20px; flex: 1; min-width: 250px;">
        <div style="display: flex; align-items: center; gap: 15px;">
          <i class="fas fa-temperature-half" style="color: #3b82f6; font-size: 22px; width: 25px; text-align: center;"></i>
          <div style="display: flex; flex-direction: column;">
            <span style="font-size: 14px; color: #64748b;">Cảm giác như</span>
            <span style="font-weight: 800; color: #1e293b; font-size: 18px;"><%= @climate['main']['feels_like'].round %>°C</span>
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 15px;">
          <i class="fas fa-droplet" style="color: #3b82f6; font-size: 22px; width: 25px; text-align: center;"></i>
          <div style="display: flex; flex-direction: column;">
            <span style="font-size: 14px; color: #64748b;">Độ ẩm</span>
            <span style="font-weight: 800; color: #1e293b; font-size: 18px;"><%= @climate['main']['humidity'] %>%</span>
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 15px;">
          <i class="fas fa-wind" style="color: #3b82f6; font-size: 22px; width: 25px; text-align: center;"></i>
          <div style="display: flex; flex-direction: column;">
            <span style="font-size: 14px; color: #64748b;">Gió</span>
            <span style="font-weight: 800; color: #1e293b; font-size: 18px;"><%= @climate['wind']['speed'] %> m/s</span>
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 15px;">
          <i class="fas fa-eye" style="color: #3b82f6; font-size: 20px; width: 25px; text-align: center;"></i>
          <div style="display: flex; flex-direction: column;">
            <span style="font-size: 14px; color: #64748b;">Tầm nhìn</span>
            <span style="font-weight: 800; color: #1e293b; font-size: 18px;"><%= (@climate['visibility'].to_i / 1000.0).round(1) rescue 0 %> km</span>
          </div>
        </div>
      </div>
    </div>

    <!-- PHẦN 2: DỰ BÁO 24 GIỜ -->
    <% if @hourly.present? %>
      <div style="background: white; border-radius: 24px; padding: 30px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
        <h3 style="font-size: 20px; font-weight: 800; color: #0f172a; margin-bottom: 25px; margin-top: 0;">Dự báo hôm nay</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(80px, 1fr)); gap: 12px;">
          <% @hourly.each do |hour| %>
            <% h_icon = get_fa_icon(hour['weather'][0]['icon']) %>
            <div style="display: flex; flex-direction: column; align-items: center; background: #f8fafc; padding: 18px 5px; border-radius: 16px;">
              <span style="font-size: 14px; font-weight: 700; color: #64748b; margin-bottom: 12px;"><%= Time.parse(hour['dt_txt']).strftime("%H:%M") %></span>
              <i class="<%= h_icon[:class] %>" style="font-size: 30px; color: <%= h_icon[:color] %>; margin-bottom: 15px;"></i>
              <span style="font-weight: 900; font-size: 20px; color: #0f172a;"><%= hour['main']['temp'].round %>°</span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>

  <!-- CỘT PHẢI (Dự báo 5 ngày) -->
  <div class="weather-dashboard-right">
    <% if @forecast.present? %>
      <div style="background: white; border-radius: 24px; padding: 30px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.03); height: 100%;">
        <h3 style="font-size: 20px; font-weight: 800; color: #0f172a; margin-bottom: 25px; margin-top: 0;">Dự báo 5 ngày tới</h3>
        <div style="display: flex; flex-direction: column; gap: 15px;">
          <% @forecast.each do |day| %>
            <% d_icon = get_fa_icon(day['weather'][0]['icon']) %>
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 18px 20px; background: #f8fafc; border-radius: 16px; border-left: 5px solid <%= d_icon[:color] %>;">
              
              <!-- Thứ & Ngày -->
              <div style="display: flex; flex-direction: column; gap: 6px; width: 90px;">
                <span style="font-weight: 800; color: #1e293b; font-size: 15px;"><%= get_weekday(day['dt_txt']) %></span>
                <span style="font-size: 13px; color: #94a3b8; font-weight: 500;"><%= Date.parse(day['dt_txt']).strftime("%d/%m") %></span>
              </div>
              
              <!-- Icon & Mô tả -->
              <div style="display: flex; align-items: center; gap: 15px; flex: 1;">
                <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                  <i class="<%= d_icon[:class] %>" style="color: <%= d_icon[:color] %>; font-size: 26px;"></i>
                </div>
                <span style="font-size: 14px; color: #475569; text-transform: capitalize; font-weight: 600;"><%= day['weather'][0]['description'] %></span>
              </div>
              
              <!-- Cao nhất / Thấp nhất -->
              <div style="display: flex; flex-direction: column; align-items: flex-end; width: 60px;">
                <span style="font-weight: 900; font-size: 18px; color: #ef4444;"><%= day['main']['temp_max'].round %>°</span>
                <span style="font-weight: 700; font-size: 14px; color: #3b82f6;"><%= day['main']['temp_min'].round %>°</span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

</div>
