<% content_for :extra_css do %>
  <%= stylesheet_link_tag 'home', media: 'all' %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<% end %>

<div class="home-container">
  <div class="main-content">
    <div class="home-section">
      <div class="home-heading">
        <h1>Tra cứu thời tiết</h1>
        <h2>Nhập tên thành phố để tra cứu thời tiết</h2>
      </div>

      <%= form_with url: root_path, method: :get, local: true, class: 'search-form' do |form| %>
        <div class="input-group">
          <%= form.text_field :city, value: params[:city], placeholder: "Nhập tên thành phố", class: 'search-input' %>
          <%= form.button type: "submit", class: 'btn-search' do %>
            <i class="fas fa-search"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  <%= render 'result_form' %>
  <%= render 'login_sidebar_item' %>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const favBtn = document.getElementById("js-fav-btn");
  if (!favBtn) return;

  favBtn.addEventListener("click", async function (e) {
    e.preventDefault();

    const city = this.dataset.city;
    let favId = this.dataset.favId;
    const isFavorite = this.classList.contains("is-favorite");

    const heartIcon = this.querySelector("i");
    const favText = document.getElementById("js-fav-text");

    if (isFavorite) {
      this.classList.remove("is-favorite");
      heartIcon.className = "far fa-heart";
      heartIcon.style.color = "#64748b";
      if (favText) favText.innerText = "Thêm vào yêu thích";
    } else {
      this.classList.add("is-favorite");
      heartIcon.className = "fas fa-heart";
      heartIcon.style.color = "#ef4444";
      if (favText) favText.innerText = "Đã yêu thích";
    }

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    try {
      let url = "/favorites";
      let options = {
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": csrfToken
        }
      };

      if (isFavorite && favId) {
        options.method = "DELETE";
        url = `/favorites/${favId}`;
      } else {
        options.method = "POST";
        options.body = JSON.stringify({ city_name: city });
      }

      const response = await fetch(url, options);
      const data = await response.json();

      if (data.success) {
        if (data.action === "created") {
          this.dataset.favId = data.favorite_id;
        } else if (data.action === "destroyed") {
          this.dataset.favId = "";
        }
      } else {
        alert(data.error || "Có lỗi xảy ra");
      }
    } catch (err) {
      console.error("Lỗi kết nối:", err);
    }
  });
});
</script>