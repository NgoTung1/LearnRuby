<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Weather on Rails" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= stylesheet_link_tag 'chatbot', media: 'all'%>
    <%= yield :extra_css %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  </head>
  
  <body>
    <%= render 'layouts/header' %>
    <% if notice %>
      <div style="background: #d4edda; color: #155724; padding: 10px; text-align: center;"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div style="background: #f8d7da; color: #721c24; padding: 10px; text-align: center;"><%= alert %></div>
    <% end %>

    <main class="container">
      <%= yield %>
    </main>
    
    <%= render 'layouts/footer'%>
    <%= render 'layouts/chatbot' %>
  </body>
</html>