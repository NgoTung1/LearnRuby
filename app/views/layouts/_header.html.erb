<header class="navbar">
  <%= link_to "Weather on Rails", root_path, class: "logo" %>
  <nav  >
    <% if logged_in?%>
      <%= link_to "Thành phố yêu thích", "#" %>
      <%= link_to "Lịch sử tìm kiếm", "#" %>
      <%= button_to "Đăng xuất", login_path, method: :delete, class: "logout-btn" %>
    <% else %>
      <%= link_to "Đăng nhập", login_path %>
      <%= link_to "Đăng ký", register_path %>
    <% end %>
  </nav>
</header>