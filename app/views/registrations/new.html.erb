<div style="max-width: 400px; margin: 50px auto; border: 1px solid #ccc; padding: 20px; border-radius: 8px;">
  <h2 style="text-align: center;">Đăng ký tài khoản</h2>

  <%= form_with(model: @user, url: register_path, local: true) do |f| %>
    
    <% if @user.errors.any? %>
      <div style="color: red; margin-bottom: 15px;">
        <ul>
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 15px;">
      <%= f.label :email, "Email của bạn:" %><br>
      <%= f.email_field :email, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :password, "Mật khẩu:" %><br>
      <%= f.password_field :password, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= f.label :password_confirmation, "Nhập lại mật khẩu:" %><br>
      <%= f.password_field :password_confirmation, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <%= f.submit "Tạo tài khoản", style: "width: 100%; padding: 10px; background: #007bff; color: white; border: none; cursor: pointer;" %>
  <% end %>

  <p style="text-align: center; margin-top: 15px;">
    Đã có tài khoản? <%= link_to "Đăng nhập", login_path %>
  </p>
</div>