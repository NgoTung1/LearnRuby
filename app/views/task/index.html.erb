<div class="max-w-4xl mx-auto p-8">
  <h1 class="text-3xl font-bold text-center mb-8 text-gray-800">
    Danh sách công việc của tôi
  </h1>

  <div clas=s"grid grid-cols-1 md:grid-cols-2 gap-6">
   <% @tasks.each do |task| %>
