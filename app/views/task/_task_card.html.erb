<div class="border-2 rounded-lg p-5 shadow-sm bg-white flex flex-col 
            <%= task[:status] == 'completed' ? 'border-green-400' : 'border-yellow-400' %>">
  
  <h2 class="text-xl font-bold text-gray-800 mb-2"><%= task[:title] %></h2>
  <p class="text-gray-600 mb-4 flex-grow"><%= task[:description] %></p>

  <div class="flex justify-between items-center mt-auto border-t pt-4">
    
    <% if task[:status] == "completed" %>
      <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-semibold">
        Đã hoàn thành
      </span>
    <% else %>
      <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-sm font-semibold">
        Đang chờ
      </span>
    <% end %>

    <%= link_to "Chi tiết", "#", class: "text-blue-600 hover:text-blue-800 font-medium text-sm underline" %>
    
  </div>
</div>